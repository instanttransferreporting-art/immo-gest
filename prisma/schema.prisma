// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 0. ORGANISATION (MULTI-TENANT)
// ==========================================

model Organization {
  id                   String   @id @default(uuid())
  nom                  String
  logo                 String?
  tauxCommissionDefaut Float    @default(10)
  tauxPenaliteRetard   Float    @default(5) // Pourcentage appliqué sur le total dû à partir de la relance Niveau 1 BIS (J+15)
  adresse              String?
  ville                String?
  telephone            String?
  email                String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users         User[]
  auditLogs     AuditLog[]
  proprietaires Proprietaire[]
  immeubles     Immeuble[]
  unites        Unite[]
  locataires    Locataire[]
  contrats      ContratBail[]
  echeances     EcheanceLoyer[]
  factures      Facture[]
  paiements     Paiement[]
  relances      Relance[]
  cautions      Caution[]
  maintenances  Maintenance[]
  reversements  Reversement[]
  incidents     Incident[]

  @@map("organizations")
}

// ==========================================
// 1. UTILISATEURS, RÔLES & PERMISSIONS
// ==========================================

enum RoleType {
  SUPER_ADMIN
  ADMIN
  GESTIONNAIRE
  COMPTABLE
  DIRECTEUR_GENERAL
}

model User {
  id             String   @id @default(uuid())
  organizationId String?
  nom            String
  prenom         String
  email          String   @unique
  passwordHash   String
  role           RoleType
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  // Relations
  paiementsEnregistres Paiement[]
  paiementsAnnules     Paiement[]    @relation("PaiementAnnulePar")
  actionsAudit         AuditLog[]
  demandesMaintenance  Maintenance[] @relation("TechnicienMaintenance")

  @@index([organizationId])
  @@map("users")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  action         String
  details        String?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@map("audit_logs")
}

// ==========================================
// 2. PROPRIÉTAIRES
// ==========================================

model Proprietaire {
  id             String   @id @default(uuid())
  organizationId String
  nom            String
  prenom         String?
  adresse        String
  ville          String
  tauxCommission Float    @default(10) // Pourcentage prélevé par l'agence sur les loyers encaissés
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  // Relations
  telephones   TelephoneProprietaire[]
  emails       EmailProprietaire[]
  immeubles    Immeuble[]
  reversements Reversement[]

  @@index([organizationId])
  @@map("proprietaires")
}

model TelephoneProprietaire {
  id             String       @id @default(uuid())
  proprietaireId String
  numero         String // Format validé avec indicatif pays
  estPrincipal   Boolean      @default(false)
  proprietaire   Proprietaire @relation(fields: [proprietaireId], references: [id], onDelete: Cascade)

  @@map("telephone_proprietaires")
}

model EmailProprietaire {
  id             String       @id @default(uuid())
  proprietaireId String
  email          String // Email professionnel
  estPrincipal   Boolean      @default(false)
  proprietaire   Proprietaire @relation(fields: [proprietaireId], references: [id], onDelete: Cascade)

  @@map("email_proprietaires")
}

// ==========================================
// 3. PATRIMOINE IMMOBILIER & UNITÉS
// ==========================================

model Immeuble {
  id               String   @id @default(uuid())
  organizationId   String
  reference        String // Générée automatiquement, unique par organisation
  nom              String
  adresse          String
  ville            String
  nombreNiveaux    Int
  nombreLogements  Int
  valeurEstimative Float?
  proprietaireId   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  proprietaire Proprietaire @relation(fields: [proprietaireId], references: [id])
  unites       Unite[]
  incidents    Incident[]

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@map("immeubles")
}

enum TypeUnite {
  APPARTEMENT
  VILLA
  BUREAU
  COMMERCE
  ENTREPOT
  STUDIO
  CHAMBRE
  DUPLEX
}

enum EtatUnite {
  LIBRE
  OCCUPE
  RESERVE
}

enum TypeCharges {
  FORFAITAIRE
  POURCENTAGE
}

enum FrequencePaiement {
  NUITEE
  HEBDOMADAIRE
  MENSUEL
  TRIMESTRIEL
  ANNUEL
  AUTRE
}

model Unite {
  id                  String            @id @default(uuid())
  organizationId      String
  immeubleId          String
  numero              String // Ex: A21, B34
  type                TypeUnite
  surface             Float
  nombrePieces        Int
  loyerMensuel        Float
  typeCharges         TypeCharges
  valeurCharges       Float // Montant fixe ou pourcentage du loyer
  caution             Float // Dépôt de garantie
  etat                EtatUnite         @default(LIBRE)
  isMeuble            Boolean           @default(false)
  frequencePaiement   FrequencePaiement @default(MENSUEL)
  frequenceAutreTexte String? // Texte libre quand frequencePaiement = AUTRE
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  immeuble     Immeuble      @relation(fields: [immeubleId], references: [id], onDelete: Cascade)
  contrats     ContratBail[]
  incidents    Incident[]

  @@index([organizationId])
  @@map("unites")
}

// ==========================================
// 4. LOCATAIRES & ARCHIVAGE DOCUMENTAIRE
// ==========================================

enum TypeLocataire {
  PHYSIQUE
  MORALE
}

model Locataire {
  id             String        @id @default(uuid())
  organizationId String
  type           TypeLocataire

  // Personne Physique ou Responsable Moral
  nom                String
  prenom             String
  dateNaissance      DateTime?
  profession         String?
  telephone          String
  email              String // Unique par organisation
  adresse            String
  pieceIdentite      String // Numéro de CNI / Passeport / Carte de séjour
  revenuMensuelMoyen Float? // Obligatoire pour les physiques

  // Personne Morale (Optionnel)
  raisonSociale  String?
  rccm           String?
  niu            String?
  telephoneMoral String?
  emailMoral     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  // Relations
  contrats  ContratBail[]
  documents DocumentLocataire[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("locataires")
}

model DocumentLocataire {
  id            String   @id @default(uuid())
  locataireId   String
  typeDocument  String // CNI, PHOTO_4X4, CONTRAT_SIMPLIFIE, CONTRAT_SIGNE, PREUVE_ENREGISTREMENT
  cheminFichier String
  createdAt     DateTime @default(now())

  locataire Locataire @relation(fields: [locataireId], references: [id], onDelete: Cascade)

  @@map("document_locataires")
}

// ==========================================
// 5. CONTRATS DE BAIL & ÉCHÉANCIERS
// ==========================================

enum FrequenceEcheance {
  QUOTIDIEN
  MENSUEL
  BIMENSUEL
  TRIMESTRIEL
  SEMESTRIEL
  ANNUEL
}

enum StatutBail {
  ACTIF
  SUSPENDU
  RESILIE
  EXPIRE
}

model ContratBail {
  id               String            @id @default(uuid())
  organizationId   String
  numeroContrat    String // Générée automatiquement, unique par organisation
  uniteId          String
  locataireId      String
  dateDebut        DateTime
  dateFin          DateTime // Aligné au 31 décembre
  loyerBase        Float
  charges          Float
  depotGarantie    Float
  frequence        FrequenceEcheance @default(MENSUEL)
  nombreNuitees    Int? // Pour les baux à la nuitée (frequence = QUOTIDIEN)
  statut           StatutBail        @default(ACTIF)
  motifResiliation String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  unite        Unite           @relation(fields: [uniteId], references: [id])
  locataire    Locataire       @relation(fields: [locataireId], references: [id])
  echeances    EcheanceLoyer[]
  cautions     Caution[]

  @@unique([organizationId, numeroContrat])
  @@index([organizationId])
  @@map("contrats_bail")
}

model EcheanceLoyer {
  id             String   @id @default(uuid())
  organizationId String
  contratId      String
  dateEcheance   DateTime
  montantLoyer   Float
  montantCharges Float
  montantTotal   Float
  soldeRestant   Float
  estPaye        Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  contrat      ContratBail  @relation(fields: [contratId], references: [id], onDelete: Cascade)
  factures     Facture[]
  paiements    Paiement[]
  relances     Relance[]

  @@index([organizationId])
  @@map("echeances_loyer")
}

// ==========================================
// 6. FACTURATION, PAIEMENTS & TRÉSORERIE
// ==========================================

enum ModePaiement {
  ESPECES // Exceptionnel, direction uniquement
  VIREMENT_BANCAIRE
  MOBILE_MONEY
  // Interdit : CHEQUE
}

model Facture {
  id             String    @id @default(uuid())
  organizationId String
  numero         String // Générée automatiquement, unique par organisation
  echeanceId     String
  montant        Float
  penalites      Float     @default(0)
  totalDu        Float
  dateEmission   DateTime  @default(now())
  estSoldee      Boolean   @default(false)
  avisEnvoye     Boolean   @default(false)
  avisEnvoyeAt   DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  echeance     EcheanceLoyer @relation(fields: [echeanceId], references: [id])
  paiements    Paiement[]

  @@unique([organizationId, numero])
  @@index([organizationId])
  @@map("factures")
}

model Paiement {
  id              String       @id @default(uuid())
  organizationId  String
  factureId       String
  echeanceId      String
  userId          String // Utilisateur ayant enregistré le paiement
  mode            ModePaiement
  montant         Float
  reference       String? // Réf transaction Mobile Money ou virement, ou reçu physique espèces
  datePaiement    DateTime     @default(now())
  estAnnule       Boolean      @default(false) // Nécessite double validation si modification/annulation
  motifAnnulation String?
  dateAnnulation  DateTime?
  annuleParId     String?

  organization  Organization  @relation(fields: [organizationId], references: [id])
  facture       Facture       @relation(fields: [factureId], references: [id])
  echeance      EcheanceLoyer @relation(fields: [echeanceId], references: [id])
  enregistrePar User          @relation(fields: [userId], references: [id])
  annulePar     User?         @relation("PaiementAnnulePar", fields: [annuleParId], references: [id])

  @@index([organizationId])
  @@map("paiements")
}

// ==========================================
// 7. IMPAYÉS & RELANCES
// ==========================================

enum NiveauRelance {
  NIVEAU_1 // Rappel amiable à l'échéance
  NIVEAU_1_BIS // 2ème rappel amiable + facture pénalités (J+15)
  NIVEAU_2 // Mise en demeure (J+30)
  NIVEAU_3 // Procédure contentieuse (avocat)
}

model Relance {
  id             String        @id @default(uuid())
  organizationId String
  echeanceId     String
  niveau         NiveauRelance
  dateEnvoi      DateTime      @default(now())
  details        String?

  organization Organization  @relation(fields: [organizationId], references: [id])
  echeance     EcheanceLoyer @relation(fields: [echeanceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("relances")
}

// ==========================================
// 8. CAUTIONS & RESTITUTIONS
// ==========================================

enum StatutCaution {
  EN_COURS
  RESTITUEE_TOTALE
  RESTITUEE_PARTIELLE
  RETENUE_TRAVAUX
}

model Caution {
  id              String        @id @default(uuid())
  organizationId  String
  contratId       String
  montantInitial  Float
  montantRetenu   Float         @default(0)
  montantRendu    Float         @default(0)
  statut          StatutCaution @default(EN_COURS)
  dateRestitution DateTime?
  notes           String?
  createdAt       DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  contrat      ContratBail  @relation(fields: [contratId], references: [id])

  @@index([organizationId])
  @@map("cautions")
}

// ==========================================
// 9. MAINTENANCE & TRAVAUX
// ==========================================

enum CategorieMaintenance {
  PLOMBERIE
  ELECTRICITE
  PEINTURE
  SECURITE
  CLIMATISATION
  AUTRE
}

enum StatutMaintenance {
  OUVERT
  EN_COURS
  RESOLU
  ANNULE
}

model Maintenance {
  id             String               @id @default(uuid())
  organizationId String
  technicienId   String?
  categorie      CategorieMaintenance
  description    String
  prestataire    String?
  cout           Float?
  statut         StatutMaintenance    @default(OUVERT)
  dateDemande    DateTime             @default(now())
  dateResolution DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  technicien   User?        @relation("TechnicienMaintenance", fields: [technicienId], references: [id])

  @@index([organizationId])
  @@map("maintenances")
}

// ==========================================
// 10. REVERSEMENTS PROPRIÉTAIRES
// ==========================================

enum StatutReversement {
  BROUILLON
  VALIDE
}

model Reversement {
  id             String            @id @default(uuid())
  organizationId String
  proprietaireId String
  mois           Int
  annee          Int
  totalEncaisse  Float
  tauxCommission Float
  commission     Float
  netAPayer      Float
  statut         StatutReversement @default(BROUILLON)
  dateGeneration DateTime          @default(now())
  dateValidation DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  proprietaire Proprietaire @relation(fields: [proprietaireId], references: [id])

  @@unique([proprietaireId, mois, annee])
  @@index([organizationId])
  @@map("reversements")
}

// ==========================================
// 11. INCIDENTS (TICKETING)
// ==========================================

enum PrioriteIncident {
  BASSE
  MOYENNE
  HAUTE
}

enum StatutIncident {
  NOUVEAU
  EN_COURS
  RESOLU
}

model Incident {
  id              String           @id @default(uuid())
  organizationId  String
  titre           String
  description     String
  priorite        PrioriteIncident
  statut          StatutIncident   @default(NOUVEAU)
  uniteId         String?
  immeubleId      String?
  prestataire     String?
  dateSignalement DateTime         @default(now())
  dateResolution  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  unite        Unite?       @relation(fields: [uniteId], references: [id], onDelete: Cascade)
  immeuble     Immeuble?    @relation(fields: [immeubleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("incidents")
}
